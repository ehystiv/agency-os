[gd_scene format=3]

[ext_resource type="Script" path="res://apps/dossier/dossier.gd" id="1_script"]

[node name="Dossier" type="MarginContainer"]
size_flags_vertical = 3
theme_override_constants/margin_left = 8
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 8
theme_override_constants/margin_bottom = 8
script = ExtResource("1_script")

[node name="Scroll" type="ScrollContainer" parent="."]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 600)
layout_mode = 2
horizontal_scroll_mode = 0

[node name="Layout" type="VBoxContainer" parent="Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 14

[node name="LevelSection" type="VBoxContainer" parent="Scroll/Layout"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Title" type="Label" parent="Scroll/Layout/LevelSection"]
layout_mode = 2
theme_type_variation = &"FieldLabel"
text = "Livello di accesso"
uppercase = true

[node name="Row" type="HBoxContainer" parent="Scroll/Layout/LevelSection"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Level" type="Label" parent="Scroll/Layout/LevelSection/Row"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"AccessNumber"
text = "1"

[node name="Pips" type="HBoxContainer" parent="Scroll/Layout/LevelSection/Row"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
theme_override_constants/separation = 4

[node name="Pip1" type="ColorRect" parent="Scroll/Layout/LevelSection/Row/Pips"]
custom_minimum_size = Vector2(0, 10)
layout_mode = 2
size_flags_horizontal = 3

[node name="Pip2" type="ColorRect" parent="Scroll/Layout/LevelSection/Row/Pips"]
custom_minimum_size = Vector2(0, 10)
layout_mode = 2
size_flags_horizontal = 3

[node name="Pip3" type="ColorRect" parent="Scroll/Layout/LevelSection/Row/Pips"]
custom_minimum_size = Vector2(0, 10)
layout_mode = 2
size_flags_horizontal = 3

[node name="Pip4" type="ColorRect" parent="Scroll/Layout/LevelSection/Row/Pips"]
custom_minimum_size = Vector2(0, 10)
layout_mode = 2
size_flags_horizontal = 3

[node name="Pip5" type="ColorRect" parent="Scroll/Layout/LevelSection/Row/Pips"]
custom_minimum_size = Vector2(0, 10)
layout_mode = 2
size_flags_horizontal = 3

[node name="LevelHint" type="Label" parent="Scroll/Layout/LevelSection"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HintLabel"
text = "Cresce a ogni colloquio concluso."
autowrap_mode = 3

[node name="NotesSection" type="VBoxContainer" parent="Scroll/Layout"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Title" type="Label" parent="Scroll/Layout/NotesSection"]
layout_mode = 2
theme_type_variation = &"FieldLabel"
text = "Il Manager e la campagna"
uppercase = true

[node name="Notes" type="TextEdit" parent="Scroll/Layout/NotesSection"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 120)
layout_mode = 2
placeholder_text = "Chi è il tuo Manager, com'è la Filiale, gli Agenti, cosa è successo nell'ultimo Incarico…"
wrap_mode = 1

[node name="Row" type="HBoxContainer" parent="Scroll/Layout/NotesSection"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="SaveNotes" type="Button" parent="Scroll/Layout/NotesSection/Row"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
text = "Salva"

[node name="NotesSaved" type="Label" parent="Scroll/Layout/NotesSection/Row"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"SavedLabel"
text = "Salvato"

[node name="Hint" type="Label" parent="Scroll/Layout/NotesSection"]
layout_mode = 2
theme_type_variation = &"HintLabel"
text = "L'Entità e l'Agenzia leggono queste note."
autowrap_mode = 3

[node name="ListSection" type="VBoxContainer" parent="Scroll/Layout"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Header" type="HBoxContainer" parent="Scroll/Layout/ListSection"]
layout_mode = 2

[node name="Title" type="Label" parent="Scroll/Layout/ListSection/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"FieldLabel"
text = "Colloqui"
uppercase = true

[node name="NewInterview" type="Button" parent="Scroll/Layout/ListSection/Header"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
text = "Nuovo colloquio"

[node name="Panel" type="PanelContainer" parent="Scroll/Layout/ListSection"]
layout_mode = 2
theme_type_variation = &"SunkenPanel"

[node name="Scroll" type="ScrollContainer" parent="Scroll/Layout/ListSection/Panel"]
custom_minimum_size = Vector2(0, 150)
layout_mode = 2
horizontal_scroll_mode = 0

[node name="List" type="VBoxContainer" parent="Scroll/Layout/ListSection/Panel/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 0

[node name="Empty" type="Label" parent="Scroll/Layout/ListSection/Panel/Scroll/List"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HintLabel"
text = "Nessun colloquio registrato. Apri la linea per iniziare."
autowrap_mode = 3

[node name="Rows" type="VBoxContainer" parent="Scroll/Layout/ListSection/Panel/Scroll/List"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 0

[node name="MemorySection" type="VBoxContainer" parent="Scroll/Layout"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="MemoryToggle" type="LinkButton" parent="Scroll/Layout/MemorySection"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 0
focus_mode = 0
text = "▸ Ricordi dell'Entità"
underline = 2

[node name="MemoryBox" type="VBoxContainer" parent="Scroll/Layout/MemorySection"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_constants/separation = 6

[node name="Hint" type="Label" parent="Scroll/Layout/MemorySection/MemoryBox"]
layout_mode = 2
theme_type_variation = &"HintLabel"
text = "Ciò che l'Entità ricorda di tutti i colloqui. Se correggi, la tua versione diventa la verità."
autowrap_mode = 3

[node name="Memory" type="TextEdit" parent="Scroll/Layout/MemorySection/MemoryBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 150)
layout_mode = 2
placeholder_text = "Ancora nessun ricordo."
wrap_mode = 1

[node name="Row" type="HBoxContainer" parent="Scroll/Layout/MemorySection/MemoryBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="SaveMemory" type="Button" parent="Scroll/Layout/MemorySection/MemoryBox/Row"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
text = "Salva"

[node name="MemorySaved" type="Label" parent="Scroll/Layout/MemorySection/MemoryBox/Row"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"SavedLabel"
text = "Salvato"

[node name="ResetLink" type="LinkButton" parent="Scroll/Layout"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 8
focus_mode = 0
theme_type_variation = &"LinkDanger"
text = "Azzera la Filiale…"

[node name="ResetBox" type="PanelContainer" parent="Scroll/Layout"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"ResetPanel"

[node name="Box" type="VBoxContainer" parent="Scroll/Layout/ResetBox"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Title" type="Label" parent="Scroll/Layout/ResetBox/Box"]
layout_mode = 2
theme_type_variation = &"FieldLabel"
theme_override_colors/font_color = Color(0.898, 0.149, 0.1725, 1)
text = "Protocollo di azzeramento"
uppercase = true

[node name="Text" type="Label" parent="Scroll/Layout/ResetBox/Box"]
layout_mode = 2
theme_type_variation = &"HintLabel"
text = "Cancella per sempre colloqui, ricordi dell'Entità, posta, file della scrivania e cestino, azzera il Caos e riporta il livello di accesso a 1. Ti conviene esportare prima ciò che vuoi tenere. Non si può annullare."
autowrap_mode = 3

[node name="KeepNotes" type="CheckBox" parent="Scroll/Layout/ResetBox/Box"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
button_pressed = true
text = "Mantieni le note del Manager e il Taccuino"

[node name="ExportFirst" type="Button" parent="Scroll/Layout/ResetBox/Box"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
text = "Esporta prima tutto in Obsidian"

[node name="Buttons" type="HBoxContainer" parent="Scroll/Layout/ResetBox/Box"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="ResetGo" type="Button" parent="Scroll/Layout/ResetBox/Box/Buttons"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
theme_type_variation = &"DangerButton"
text = "Cancella tutto"

[node name="ResetCancel" type="Button" parent="Scroll/Layout/ResetBox/Box/Buttons"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
text = "Annulla"
