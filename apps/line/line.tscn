[gd_scene format=3]

[ext_resource type="Script" path="res://apps/line/line.gd" id="1_script"]
[ext_resource type="Script" path="res://apps/line/effects/glitch_layer.gd" id="2_glitch"]

[node name="Line" type="MarginContainer"]
size_flags_vertical = 3
script = ExtResource("1_script")

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 0

[node name="StatusRow" type="MarginContainer" parent="Layout"]
layout_mode = 2
theme_override_constants/margin_left = 8
theme_override_constants/margin_top = 4
theme_override_constants/margin_right = 8
theme_override_constants/margin_bottom = 5

[node name="Row" type="HBoxContainer" parent="Layout/StatusRow"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Led" type="ColorRect" parent="Layout/StatusRow/Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(8, 8)
layout_mode = 2
size_flags_vertical = 4
color = Color(0.2275, 0.2471, 0.2941, 1)

[node name="StatusText" type="Label" parent="Layout/StatusRow/Row"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"StatusLabel"
text = "Linea chiusa"

[node name="Info" type="Label" parent="Layout/StatusRow/Row"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"StatusLabel"
text = "Accesso 1"

[node name="Export" type="LinkButton" parent="Layout/StatusRow/Row"]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_vertical = 4
focus_mode = 0
text = "Esporta .md"

[node name="Back" type="LinkButton" parent="Layout/StatusRow/Row"]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_vertical = 4
focus_mode = 0
text = "Torna al colloquio in corso"

[node name="Pane" type="PanelContainer" parent="Layout"]
custom_minimum_size = Vector2(0, 380)
layout_mode = 2
size_flags_vertical = 3
theme_type_variation = &"ChatPane"

[node name="Scroll" type="ScrollContainer" parent="Layout/Pane"]
unique_name_in_owner = true
layout_mode = 2
horizontal_scroll_mode = 0

[node name="Log" type="VBoxContainer" parent="Layout/Pane/Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 16

[node name="Splash" type="CenterContainer" parent="Layout/Pane"]
unique_name_in_owner = true
layout_mode = 2

[node name="Box" type="VBoxContainer" parent="Layout/Pane/Splash"]
custom_minimum_size = Vector2(340, 0)
layout_mode = 2
theme_override_constants/separation = 14

[node name="Title" type="Label" parent="Layout/Pane/Splash/Box"]
layout_mode = 2
theme_type_variation = &"SplashTitle"
text = "LINEA RISERVATA"
horizontal_alignment = 1

[node name="Ink" type="Label" parent="Layout/Pane/Splash/Box"]
layout_mode = 2
theme_type_variation = &"SplashInk"
text = "hey. sei tu? sei da solo?"
horizontal_alignment = 1

[node name="Text" type="Label" parent="Layout/Pane/Splash/Box"]
layout_mode = 2
theme_type_variation = &"SplashText"
text = "Nessun colloquio aperto. Quando apri la linea, l'Entità ti sentirà."
horizontal_alignment = 1
autowrap_mode = 3

[node name="Open" type="Button" parent="Layout/Pane/Splash/Box"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 4
theme_type_variation = &"PrimaryButton"
text = "Apri la linea"

[node name="SplashSettings" type="LinkButton" parent="Layout/Pane/Splash/Box"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 4
focus_mode = 0
text = "Impostazioni della linea…"

[node name="GlitchLayer" type="Control" parent="Layout/Pane"]
unique_name_in_owner = true
clip_contents = true
layout_mode = 2
mouse_filter = 2
script = ExtResource("2_glitch")

[node name="Composer" type="MarginContainer" parent="Layout"]
layout_mode = 2
theme_override_constants/margin_top = 6

[node name="Row" type="HBoxContainer" parent="Layout/Composer"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Input" type="TextEdit" parent="Layout/Composer/Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 56)
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "Scrivi all'Entità…"
wrap_mode = 1

[node name="Side" type="VBoxContainer" parent="Layout/Composer/Row"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Send" type="Button" parent="Layout/Composer/Row/Side"]
unique_name_in_owner = true
custom_minimum_size = Vector2(78, 0)
layout_mode = 2
focus_mode = 0
theme_type_variation = &"PrimaryButton"
text = "Invia"

[node name="Stop" type="Button" parent="Layout/Composer/Row/Side"]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(78, 0)
layout_mode = 2
focus_mode = 0
text = "Ferma"

[node name="Tools" type="MarginContainer" parent="Layout"]
custom_minimum_size = Vector2(0, 24)
layout_mode = 2
theme_override_constants/margin_left = 6
theme_override_constants/margin_top = 4
theme_override_constants/margin_right = 6
theme_override_constants/margin_bottom = 2

[node name="Row" type="HBoxContainer" parent="Layout/Tools"]
layout_mode = 2

[node name="Hint" type="Label" parent="Layout/Tools/Row"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"StatusLabel"
text = "Invio per mandare, Maiusc+Invio per andare a capo"

[node name="End" type="LinkButton" parent="Layout/Tools/Row"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
text = "Termina la sessione"
