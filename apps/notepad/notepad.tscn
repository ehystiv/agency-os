[gd_scene format=3]

[ext_resource type="Script" path="res://apps/notepad/notepad.gd" id="1_script"]

[node name="Notepad" type="MarginContainer"]
size_flags_vertical = 3
script = ExtResource("1_script")

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 3

[node name="Text" type="TextEdit" parent="Layout"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 100)
layout_mode = 2
size_flags_vertical = 3
theme_type_variation = &"NoteEdit"
wrap_mode = 1

[node name="FindBar" type="HBoxContainer" parent="Layout"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_constants/separation = 6

[node name="FindLabel" type="Label" parent="Layout/FindBar"]
layout_mode = 2
text = "Trova:"

[node name="FindField" type="LineEdit" parent="Layout/FindBar"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3

[node name="FindNext" type="Button" parent="Layout/FindBar"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
text = "Trova successivo"

[node name="FindClose" type="Button" parent="Layout/FindBar"]
unique_name_in_owner = true
custom_minimum_size = Vector2(24, 0)
layout_mode = 2
tooltip_text = "Chiudi la ricerca"
focus_mode = 0
text = "×"

[node name="Status" type="RichTextLabel" parent="Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"NoteStatus"
bbcode_enabled = true
fit_content = true
scroll_active = false

[node name="Buttons" type="HBoxContainer" parent="Layout"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Save" type="Button" parent="Layout/Buttons"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
theme_type_variation = &"PrimaryButton"
text = "Salva correzione"

[node name="Restore" type="Button" parent="Layout/Buttons"]
unique_name_in_owner = true
visible = false
layout_mode = 2
focus_mode = 0
text = "Ripristina la versione dell'Entità"

[node name="Saved" type="Label" parent="Layout/Buttons"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"SavedLabel"
text = "Salvato"
