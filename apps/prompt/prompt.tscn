[gd_scene format=3]

[ext_resource type="Script" path="res://apps/prompt/prompt.gd" id="1_script"]

[node name="Prompt" type="MarginContainer"]
size_flags_vertical = 3
script = ExtResource("1_script")

[node name="Screen" type="PanelContainer" parent="."]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 360)
layout_mode = 2
mouse_default_cursor_shape = 1
theme_type_variation = &"TermPane"

[node name="Layout" type="VBoxContainer" parent="Screen"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 0

[node name="Output" type="RichTextLabel" parent="Screen/Layout"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
theme_type_variation = &"TermOutput"
bbcode_enabled = true
scroll_following = true
selection_enabled = true

[node name="InputRow" type="HBoxContainer" parent="Screen/Layout"]
layout_mode = 2
theme_override_constants/separation = 0

[node name="Prompt" type="Label" parent="Screen/Layout/InputRow"]
layout_mode = 2
theme_type_variation = &"TermPrompt"
text = "C:\\FILIALE>"

[node name="Input" type="LineEdit" parent="Screen/Layout/InputRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"TermInput"
caret_blink = true
