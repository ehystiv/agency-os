[gd_scene format=3]

[ext_resource type="Script" path="res://apps/agenda/agenda.gd" id="1_script"]

[node name="Agenda" type="MarginContainer"]
size_flags_vertical = 3
script = ExtResource("1_script")

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 3

[node name="Main" type="HBoxContainer" parent="Layout"]
custom_minimum_size = Vector2(0, 260)
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 3

[node name="CalendarPanel" type="PanelContainer" parent="Layout/Main"]
layout_mode = 2
theme_type_variation = &"SunkenPanel"

[node name="Calendar" type="VBoxContainer" parent="Layout/Main/CalendarPanel"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Head" type="HBoxContainer" parent="Layout/Main/CalendarPanel/Calendar"]
layout_mode = 2

[node name="Prev" type="Button" parent="Layout/Main/CalendarPanel/Calendar/Head"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Mese precedente"
focus_mode = 0
text = "◀"

[node name="MonthTitle" type="Label" parent="Layout/Main/CalendarPanel/Calendar/Head"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"MailSubject"
text = "ottobre 2026"
horizontal_alignment = 1

[node name="Next" type="Button" parent="Layout/Main/CalendarPanel/Calendar/Head"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Mese successivo"
focus_mode = 0
text = "▶"

[node name="Grid" type="GridContainer" parent="Layout/Main/CalendarPanel/Calendar"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 2
theme_override_constants/v_separation = 2
columns = 7

[node name="SidePanel" type="PanelContainer" parent="Layout/Main"]
custom_minimum_size = Vector2(250, 0)
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"SunkenPanel"

[node name="Scroll" type="ScrollContainer" parent="Layout/Main/SidePanel"]
layout_mode = 2
horizontal_scroll_mode = 0

[node name="Margin" type="MarginContainer" parent="Layout/Main/SidePanel/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/margin_left = 6
theme_override_constants/margin_top = 4
theme_override_constants/margin_right = 8
theme_override_constants/margin_bottom = 6

[node name="Side" type="VBoxContainer" parent="Layout/Main/SidePanel/Scroll/Margin"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 5

[node name="StatusBar" type="HBoxContainer" parent="Layout"]
layout_mode = 2

[node name="Status" type="Label" parent="Layout/StatusBar"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"StatusLabel"

[node name="Today" type="LinkButton" parent="Layout/StatusBar"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
text = "Vai a oggi"
