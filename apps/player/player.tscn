[gd_scene format=3]

[ext_resource type="Script" path="res://apps/player/player.gd" id="1_script"]
[ext_resource type="Script" path="res://apps/player/music_engine.gd" id="2_engine"]
[ext_resource type="Script" path="res://apps/player/visualizer.gd" id="3_visualizer"]
[ext_resource type="Script" path="res://apps/player/youtube_fetch.gd" id="4_fetch"]
[ext_resource type="Script" path="res://apps/player/youtube_tools.gd" id="5_tools"]

[node name="Player" type="MarginContainer"]
theme_override_constants/margin_left = 4
theme_override_constants/margin_top = 4
theme_override_constants/margin_right = 4
theme_override_constants/margin_bottom = 4
script = ExtResource("1_script")

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Screen" type="PanelContainer" parent="Layout"]
layout_mode = 2
theme_type_variation = &"TermPane"

[node name="Box" type="VBoxContainer" parent="Layout/Screen"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Row" type="HBoxContainer" parent="Layout/Screen/Box"]
layout_mode = 2

[node name="NowPlaying" type="Label" parent="Layout/Screen/Box/Row"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"PlayerScreen"
text = "nessuna traccia"
clip_text = true
text_overrun_behavior = 3

[node name="Time" type="Label" parent="Layout/Screen/Box/Row"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"PlayerScreen"
text = "00:00"

[node name="Visualizer" type="Control" parent="Layout/Screen/Box"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 36)
layout_mode = 2
script = ExtResource("3_visualizer")

[node name="SeekRow" type="HBoxContainer" parent="Layout/Screen/Box"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_constants/separation = 6

[node name="Seek" type="HSlider" parent="Layout/Screen/Box/SeekRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
focus_mode = 0
max_value = 1.0
step = 0.0

[node name="Length" type="Label" parent="Layout/Screen/Box/SeekRow"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"PlayerScreen"
text = "00:00"

[node name="Controls" type="HBoxContainer" parent="Layout"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Prev" type="Button" parent="Layout/Controls"]
unique_name_in_owner = true
custom_minimum_size = Vector2(38, 28)
layout_mode = 2
tooltip_text = "Traccia precedente"
focus_mode = 0
text = "|◀"

[node name="Play" type="Button" parent="Layout/Controls"]
unique_name_in_owner = true
custom_minimum_size = Vector2(38, 28)
layout_mode = 2
tooltip_text = "Riproduci"
focus_mode = 0
text = "▶"

[node name="Stop" type="Button" parent="Layout/Controls"]
unique_name_in_owner = true
custom_minimum_size = Vector2(38, 28)
layout_mode = 2
tooltip_text = "Ferma"
focus_mode = 0
text = "■"

[node name="Next" type="Button" parent="Layout/Controls"]
unique_name_in_owner = true
custom_minimum_size = Vector2(38, 28)
layout_mode = 2
tooltip_text = "Traccia successiva"
focus_mode = 0
text = "▶|"

[node name="Loop" type="Button" parent="Layout/Controls"]
unique_name_in_owner = true
custom_minimum_size = Vector2(38, 28)
layout_mode = 2
tooltip_text = "Ripeti il brano"
focus_mode = 0
toggle_mode = true
text = "⟳"

[node name="VolumeLabel" type="Label" parent="Layout/Controls"]
layout_mode = 2
text = "Vol"

[node name="Volume" type="HSlider" parent="Layout/Controls"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
step = 1.0
value = 70.0

[node name="Tabs" type="TabBar" parent="Layout"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
current_tab = 0
tab_count = 3
tab_0/title = "Aziendali"
tab_1/title = "Cartella"
tab_2/title = "Raccolta"

[node name="FolderBar" type="HBoxContainer" parent="Layout"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_constants/separation = 6

[node name="Folder" type="Label" parent="Layout/FolderBar"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"HintLabel"
text = "Nessuna cartella"
clip_text = true
text_overrun_behavior = 3

[node name="OpenFolder" type="Button" parent="Layout/FolderBar"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
text = "Apri cartella…"

[node name="LibraryBar" type="HBoxContainer" parent="Layout"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_constants/separation = 6

[node name="AddYoutube" type="Button" parent="Layout/LibraryBar"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
text = "+ Da YouTube…"

[node name="Spacer" type="Control" parent="Layout/LibraryBar"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Rename" type="Button" parent="Layout/LibraryBar"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
text = "Rinomina"

[node name="Delete" type="Button" parent="Layout/LibraryBar"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
text = "Elimina"

[node name="YoutubeForm" type="PanelContainer" parent="Layout"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"GroupPanel"

[node name="Column" type="VBoxContainer" parent="Layout/YoutubeForm"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Grid" type="GridContainer" parent="Layout/YoutubeForm/Column"]
layout_mode = 2
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 6
columns = 2

[node name="UrlLabel" type="Label" parent="Layout/YoutubeForm/Column/Grid"]
layout_mode = 2
text = "Link"

[node name="Url" type="LineEdit" parent="Layout/YoutubeForm/Column/Grid"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "https://www.youtube.com/watch?v=…"

[node name="NameLabel" type="Label" parent="Layout/YoutubeForm/Column/Grid"]
layout_mode = 2
text = "Nome"

[node name="TrackName" type="LineEdit" parent="Layout/YoutubeForm/Column/Grid"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "Facoltativo: altrimenti il titolo del video"
max_length = 80

[node name="Row" type="HBoxContainer" parent="Layout/YoutubeForm/Column"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Download" type="Button" parent="Layout/YoutubeForm/Column/Row"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
theme_type_variation = &"PrimaryButton"
text = "Scarica"

[node name="CancelDownload" type="Button" parent="Layout/YoutubeForm/Column/Row"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
text = "Annulla"

[node name="Progress" type="ProgressBar" parent="Layout/YoutubeForm/Column/Row"]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
max_value = 1.0

[node name="FormStatus" type="Label" parent="Layout/YoutubeForm/Column"]
unique_name_in_owner = true
custom_minimum_size = Vector2(300, 0)
layout_mode = 2
theme_type_variation = &"HintLabel"
text = "L'audio viene scaricato con yt-dlp e salvato: si ascolta anche senza rete."
autowrap_mode = 3

[node name="RenameRow" type="HBoxContainer" parent="Layout"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_constants/separation = 6

[node name="RenameField" type="LineEdit" parent="Layout/RenameRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
max_length = 80

[node name="RenameSave" type="Button" parent="Layout/RenameRow"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
text = "Salva"

[node name="RenameCancel" type="Button" parent="Layout/RenameRow"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
text = "Annulla"

[node name="ListPanel" type="PanelContainer" parent="Layout"]
custom_minimum_size = Vector2(0, 140)
layout_mode = 2
size_flags_vertical = 3
theme_type_variation = &"SunkenPanel"

[node name="Scroll" type="ScrollContainer" parent="Layout/ListPanel"]
unique_name_in_owner = true
layout_mode = 2
horizontal_scroll_mode = 0

[node name="Rows" type="VBoxContainer" parent="Layout/ListPanel/Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 0

[node name="Status" type="Label" parent="Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"StatusLabel"
text = "Musiche d'attesa aziendali · sintetizzate dal vivo"
clip_text = true
text_overrun_behavior = 3

[node name="Engine" type="Node" parent="."]
unique_name_in_owner = true
script = ExtResource("2_engine")

[node name="Fetch" type="Node" parent="."]
unique_name_in_owner = true
script = ExtResource("4_fetch")

[node name="Tools" type="Node" parent="."]
unique_name_in_owner = true
script = ExtResource("5_tools")
