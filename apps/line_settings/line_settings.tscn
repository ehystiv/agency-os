[gd_scene format=3]

[ext_resource type="Script" path="res://apps/line_settings/line_settings.gd" id="1_script"]

[node name="LineSettings" type="MarginContainer"]
size_flags_vertical = 3
theme_override_constants/margin_left = 10
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 10
theme_override_constants/margin_bottom = 8
script = ExtResource("1_script")

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Grid" type="GridContainer" parent="Layout"]
layout_mode = 2
theme_override_constants/h_separation = 10
theme_override_constants/v_separation = 6
columns = 2

[node name="ProviderLabel" type="Label" parent="Layout/Grid"]
layout_mode = 2
text = "Provider"

[node name="Provider" type="OptionButton" parent="Layout/Grid"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
focus_mode = 0

[node name="ServerLabel" type="Label" parent="Layout/Grid"]
unique_name_in_owner = true
layout_mode = 2
text = "Server"

[node name="Server" type="OptionButton" parent="Layout/Grid"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
focus_mode = 0

[node name="UrlLabel" type="Label" parent="Layout/Grid"]
layout_mode = 2
text = "Indirizzo"

[node name="Url" type="LineEdit" parent="Layout/Grid"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "http://localhost:1234/v1"

[node name="KeyLabel" type="Label" parent="Layout/Grid"]
unique_name_in_owner = true
layout_mode = 2
text = "Chiave"

[node name="Key" type="LineEdit" parent="Layout/Grid"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "La chiave resta in chiaro in user://config/model.cfg. Per non salvarla, scrivi il nome di una variabile d'ambiente preceduto da $, es. $ANTHROPIC_API_KEY."
placeholder_text = "chiave di accesso oppure $NOME_VARIABILE"
secret = true

[node name="ModelLabel" type="Label" parent="Layout/Grid"]
layout_mode = 2
text = "Modello"

[node name="ModelRow" type="HBoxContainer" parent="Layout/Grid"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 6

[node name="Model" type="LineEdit" parent="Layout/Grid/ModelRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "nome del modello"

[node name="ListModels" type="Button" parent="Layout/Grid/ModelRow"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
text = "Elenca…"

[node name="ModelsPopup" type="PopupMenu" parent="Layout/Grid/ModelRow"]
unique_name_in_owner = true

[node name="TemperatureLabel" type="Label" parent="Layout/Grid"]
layout_mode = 2
text = "Temperatura"

[node name="TemperatureRow" type="HBoxContainer" parent="Layout/Grid"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Temperature" type="HSlider" parent="Layout/Grid/TemperatureRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
max_value = 1.5
step = 0.05
value = 0.9

[node name="TemperatureValue" type="Label" parent="Layout/Grid/TemperatureRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(36, 0)
layout_mode = 2
text = "0.90"

[node name="ContextLabel" type="Label" parent="Layout/Grid"]
layout_mode = 2
text = "Contesto"

[node name="ContextRow" type="HBoxContainer" parent="Layout/Grid"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Context" type="SpinBox" parent="Layout/Grid/ContextRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(110, 0)
layout_mode = 2
min_value = 1024.0
max_value = 262144.0
step = 1024.0
value = 8192.0

[node name="ContextHint" type="Label" parent="Layout/Grid/ContextRow"]
layout_mode = 2
theme_type_variation = &"StatusLabel"
text = "token che il modello può leggere"

[node name="MaxReplyLabel" type="Label" parent="Layout/Grid"]
layout_mode = 2
text = "Risposta max"

[node name="MaxReplyRow" type="HBoxContainer" parent="Layout/Grid"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="MaxReply" type="SpinBox" parent="Layout/Grid/MaxReplyRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(110, 0)
layout_mode = 2
max_value = 16384.0
step = 128.0
value = 1024.0

[node name="MaxReplyHint" type="Label" parent="Layout/Grid/MaxReplyRow"]
layout_mode = 2
theme_type_variation = &"StatusLabel"
text = "token, ragionamento compreso (0 = nessun limite)"

[node name="ReasoningLabel" type="Label" parent="Layout/Grid"]
layout_mode = 2
text = "Ragionamento"

[node name="SkipReasoning" type="CheckBox" parent="Layout/Grid"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
button_pressed = true
text = "Saltalo (Qwen e simili): risposte molto più rapide"

[node name="ReportPanel" type="PanelContainer" parent="Layout"]
custom_minimum_size = Vector2(0, 76)
layout_mode = 2
theme_type_variation = &"SunkenPanel"

[node name="Report" type="Label" parent="Layout/ReportPanel"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 1
text = "Premi «Prova connessione» per verificare server e modello."
autowrap_mode = 3

[node name="Buttons" type="HBoxContainer" parent="Layout"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Test" type="Button" parent="Layout/Buttons"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
text = "Prova connessione"

[node name="Spacer" type="Control" parent="Layout/Buttons"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2

[node name="Saved" type="Label" parent="Layout/Buttons"]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_vertical = 4
theme_type_variation = &"StatusLabel"
text = "Salvato"

[node name="Save" type="Button" parent="Layout/Buttons"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
theme_type_variation = &"PrimaryButton"
text = "Salva"
