[gd_scene format=3]

[ext_resource type="Script" path="res://apps/help/help.gd" id="1_script"]
[ext_resource type="FontFile" path="res://ui/fonts/IBMPlexMono-Medium.ttf" id="2_bold"]

[node name="Help" type="MarginContainer"]
custom_minimum_size = Vector2(300, 200)
size_flags_vertical = 3
theme_override_constants/margin_left = 6
theme_override_constants/margin_top = 6
theme_override_constants/margin_right = 6
theme_override_constants/margin_bottom = 6
script = ExtResource("1_script")

[node name="Split" type="HSplitContainer" parent="."]
layout_mode = 2
size_flags_vertical = 3
split_offset = 270

[node name="Tabs" type="TabContainer" parent="Split"]
unique_name_in_owner = true
custom_minimum_size = Vector2(180, 0)
layout_mode = 2
current_tab = 0

[node name="Contents" type="MarginContainer" parent="Split/Tabs"]
layout_mode = 2
theme_override_constants/margin_left = 6
theme_override_constants/margin_top = 6
theme_override_constants/margin_right = 6
theme_override_constants/margin_bottom = 6
metadata/_tab_index = 0

[node name="ContentsTree" type="Tree" parent="Split/Tabs/Contents"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
hide_root = true

[node name="Index" type="VBoxContainer" parent="Split/Tabs"]
visible = false
layout_mode = 2
theme_override_constants/separation = 6
metadata/_tab_index = 1

[node name="IndexLabel" type="Label" parent="Split/Tabs/Index"]
layout_mode = 2
text = "Digita la parola da cercare:"
autowrap_mode = 3

[node name="IndexText" type="LineEdit" parent="Split/Tabs/Index"]
unique_name_in_owner = true
layout_mode = 2
clear_button_enabled = true

[node name="IndexList" type="Tree" parent="Split/Tabs/Index"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
hide_root = true

[node name="Search" type="VBoxContainer" parent="Split/Tabs"]
visible = false
layout_mode = 2
theme_override_constants/separation = 6
metadata/_tab_index = 2

[node name="SearchLabel" type="Label" parent="Split/Tabs/Search"]
layout_mode = 2
text = "Digita le parole da trovare:"
autowrap_mode = 3

[node name="SearchText" type="LineEdit" parent="Split/Tabs/Search"]
unique_name_in_owner = true
layout_mode = 2
clear_button_enabled = true

[node name="SearchButton" type="Button" parent="Split/Tabs/Search"]
unique_name_in_owner = true
layout_mode = 2
text = "Elenca argomenti"

[node name="SearchList" type="Tree" parent="Split/Tabs/Search"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
hide_root = true

[node name="Page" type="PanelContainer" parent="Split"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"SunkenPanel"

[node name="PageText" type="RichTextLabel" parent="Split/Page"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/default_color = Color(0.07843, 0.08627, 0.1098, 1)
theme_override_constants/line_separation = 4
theme_override_fonts/bold_font = ExtResource("2_bold")
bbcode_enabled = true
