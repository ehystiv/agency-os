[gd_scene format=3]

[ext_resource type="Script" path="res://system/boot/boot.gd" id="1_script"]
[ext_resource type="Script" path="res://system/boot/boot_logo.gd" id="2_logo"]

[node name="Boot" type="CanvasLayer"]
layer = 50
script = ExtResource("1_script")

[node name="Screen" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 1)

[node name="Margin" type="MarginContainer" parent="Screen"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/margin_left = 40
theme_override_constants/margin_top = 32
theme_override_constants/margin_right = 40
theme_override_constants/margin_bottom = 32

[node name="Text" type="RichTextLabel" parent="Screen/Margin"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"BootText"
bbcode_enabled = true
scroll_active = false

[node name="Logo" type="Control" parent="Screen"]
unique_name_in_owner = true
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("2_logo")

[node name="Hint" type="Label" parent="Screen"]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 3
anchor_left = 1.0
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = -260.0
offset_top = -40.0
offset_right = -24.0
offset_bottom = -16.0
grow_horizontal = 0
grow_vertical = 0
theme_type_variation = &"BootHint"
text = "clic o tasto per saltare"
horizontal_alignment = 2
