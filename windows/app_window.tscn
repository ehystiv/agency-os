[gd_scene format=3]

[ext_resource type="Script" path="res://windows/app_window.gd" id="1_script"]
[ext_resource type="Texture2D" path="res://ui/icons/tri.svg" id="2_tri"]

[node name="AppWindow" type="PanelContainer"]
offset_right = 480.0
offset_bottom = 220.0
theme_type_variation = &"WindowFrame"
script = ExtResource("1_script")

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 0

[node name="TitleBar" type="PanelContainer" parent="Layout"]
unique_name_in_owner = true
layout_mode = 2
mouse_default_cursor_shape = 13
theme_type_variation = &"TitleBarInactive"

[node name="Row" type="HBoxContainer" parent="Layout/TitleBar"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 8

[node name="Triangle" type="TextureRect" parent="Layout/TitleBar/Row"]
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2
texture = ExtResource("2_tri")
stretch_mode = 3

[node name="Title" type="Label" parent="Layout/TitleBar/Row"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"TitleLabel"
text = "finestra.exe"
clip_text = true
text_overrun_behavior = 3

[node name="Buttons" type="HBoxContainer" parent="Layout/TitleBar/Row"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 2

[node name="MinButton" type="Button" parent="Layout/TitleBar/Row/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(18, 16)
layout_mode = 2
size_flags_vertical = 4
tooltip_text = "Riduci"
focus_mode = 0
mouse_default_cursor_shape = 0
theme_type_variation = &"TitleButton"
text = "_"

[node name="CloseButton" type="Button" parent="Layout/TitleBar/Row/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(18, 16)
layout_mode = 2
size_flags_vertical = 4
tooltip_text = "Chiudi"
focus_mode = 0
mouse_default_cursor_shape = 0
theme_type_variation = &"TitleButton"
text = "×"

[node name="MenuStrip" type="MarginContainer" parent="Layout"]
unique_name_in_owner = true
visible = false
layout_mode = 2
mouse_filter = 2
theme_override_constants/margin_left = 6
theme_override_constants/margin_top = 4
theme_override_constants/margin_right = 6
theme_override_constants/margin_bottom = 4

[node name="MenuItems" type="HBoxContainer" parent="Layout/MenuStrip"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 14

[node name="Content" type="MarginContainer" parent="Layout"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/margin_top = 3
