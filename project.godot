; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="AgencyOS"
config/version="0.2.0"
run/main_scene="res://desktop/desktop.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

BootPatch="*res://autoload/boot_patch.gd"
Save="*res://autoload/save.gd"
Sfx="*res://autoload/sfx.gd"
Brain="*res://autoload/brain.gd"
Campaign="*res://autoload/campaign.gd"
Entity="*res://autoload/entity.gd"
Updater="*res://autoload/updater.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://ui/theme/agency98.tres"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.039, 0.055, 0.11, 1)
